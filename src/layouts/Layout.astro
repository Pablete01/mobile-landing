---
/** biome-ignore-all lint/correctness/noUnusedImports: React components are hydrated client-side with icons */
/** biome-ignore-all lint/correctness/noUnusedVariables: Props and config are passed to nested components */

import Footer from "@footer/Footer";
import FloatingNavbar from "@ui/navigation/FloatingNavbar";
import BackToTop from "@ui/shared/BackToTop";
import { appData as defaultAppData } from "../data";

interface Props {
  title: string;
  description?: string;
  appData?: any;
  lang?: string;
  keywords?: string[];
  structuredData?: Record<string, any> | Record<string, any>[];
}

const { title, description, appData, lang = "en", keywords, structuredData } = Astro.props;
const navData = appData || defaultAppData;
const effectiveKeywords: string[] = keywords || navData.keywords || defaultAppData.keywords;
const canonicalURL = Astro.site
	? new URL(Astro.url.pathname, Astro.site)
	: Astro.url;
const ogImageURL = Astro.site && navData.logo
	? new URL(navData.logo, Astro.site).toString()
	: navData.logo;
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    {effectiveKeywords && effectiveKeywords.length > 0 && (
      <meta name="keywords" content={effectiveKeywords.join(", ")} />
    )}
    
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    {description && <meta property="og:description" content={description} />}
    {ogImageURL && <meta property="og:image" content={ogImageURL} />}
    
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    {ogImageURL && <meta name="twitter:image" content={ogImageURL} />}
    
    <link rel="icon" type="image/png" sizes="32x32" href={navData.logo} />
    <link rel="icon" type="image/png" sizes="16x16" href={navData.logo} />
    <link rel="icon" sizes="192x192" href={navData.logo} />
    <link rel="icon" sizes="512x512" href={navData.logo} />
    {structuredData && (
      <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    )}
    <script is:inline>
      const theme = localStorage.getItem('theme') || 'system';
      document.documentElement.classList.remove('light', 'dark');
      
      if (theme === 'system') {
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.classList.add(prefersDark ? 'dark' : 'light');
      } else {
        document.documentElement.classList.add(theme);
      }
      
      !localStorage.getItem('theme') && localStorage.setItem('theme', 'system');
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;600;800;900&display=swap" rel="stylesheet">
  </head>

  <body class="bg-gray-50 text-gray-900 dark:bg-black dark:text-white">
	<FloatingNavbar logo={navData.logo} title={navData.name} storeLinks={navData.storeLinks} socialLinks={defaultAppData.socialLinks} client:load />
    <div class="mx-auto min-h-screen max-w-full px-2 lg:max-w-[1500px]">
      <main><slot /></main>
      <Footer name={navData.name} logo={navData.logo} description={navData.description} client:load />
    </div>
    <BackToTop client:load />
  </body>
</html>


<style is:global>
  :root {
    font-family: 'Montserrat', sans-serif;
  }
  html.theme-switching *,
  html.theme-switching {
    transition: none !important;
  }
  
  html.light { color-scheme: light; }
  html.dark { color-scheme: dark; }

  .screenshots-scrollbar::-webkit-scrollbar {
    height: 8px;
  }
  
  .screenshots-scrollbar::-webkit-scrollbar-track {
    background: rgba(0, 0, 0, 0.05);
    border-radius: 4px;
  }
  
  .dark .screenshots-scrollbar::-webkit-scrollbar-track {
    background: rgba(255, 255, 255, 0.05);
  }
  
  .screenshots-scrollbar::-webkit-scrollbar-thumb {
    background: rgba(0, 0, 0, 0.15);
    border-radius: 4px;
  }
  
  .dark .screenshots-scrollbar::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.15);
  }
  
  .screenshots-scrollbar::-webkit-scrollbar-thumb:hover {
    background: rgba(0, 0, 0, 0.25);
  }
  
  .dark .screenshots-scrollbar::-webkit-scrollbar-thumb:hover {
    background: rgba(255, 255, 255, 0.25);
  }
</style>
