---
import Layout from "../../layouts/Layout.astro";

const appInfo = {
    name: "Dónde Repostar - Gasolineras Baratas en España",
    tagline: "Encuentra la Gasolina 95, 98, Diésel, GLP y GNC Más Baratos Cerca de Ti",
    description: "Compara el precio de la gasolina y el diésel hoy en todas las gasolineras de España con datos oficiales del Ministerio (Geoportal) y reportes de usuarios. Calcula el precio neto con Waylet (Repsol), Moeve (Cepsa), Club Carrefour, Mi BP, Shell ClubSmart, Galp y gasolineras low cost.",
    logo: "/assets/donderepostar/iconoDondeRepostar.png",
    keywords: [
        "donde repostar",
        "gasolineras baratas cerca de mi",
        "precio gasolina hoy españa",
        "precio diesel hoy españa",
        "geoportal gasolineras app",
        "gasolina 95 mas barata",
        "descuento waylet repsol",
        "descuento moeve cepsa",
        "gasolineras low cost españa",
        "ballenoil plenergy petroprix precios",
        "mapa gasolineras españa",
        "precio glp gnc españa"
    ],
    storeLinks: {
        apple: "https://apps.apple.com/es/app/donde-repostar-gasolineras/id6800650798",
        google: "https://play.google.com/store/apps/details?id=com.app.donderepostar"
    }
};

const features = [
    {
        icon: "⛽",
        title: "Datos Oficiales del Ministerio + Comunidad",
        description: "Precios actualizados de Gasolina 95 (E5), Gasolina 98 (E5), Gasóleo A (Diésel B7), Diésel Premium (B7+), GLP (Autogás), GNC y GNL en todas las estaciones de servicio de España."
    },
    {
        icon: "💳",
        title: "14 Tarjetas de Descuento en 1 Toque",
        description: "Añade desde plantilla Waylet (Repsol, Campsa, Petronor), Más / Moeve (Cepsa), Club Carrefour, Mi BP, Shell ClubSmart, Mundo Galp, Alcampo, Eroski, BonÀrea, Esclat, DISA o AVIA y ve el precio neto en el mapa."
    },
    {
        icon: "📊",
        title: "Comparativa con la Media Provincial",
        description: "Cada gasolinera incluye barra de mercado y comparativa en céntimos frente a la media de tu provincia, destacando al instante el precio mínimo provincial y cuánto ahorras al llenar."
    },
    {
        icon: "🛣️",
        title: "Planificador de Rutas y Parada Óptima",
        description: "Traza tu viaje por España con opción de evitar peajes y rutas alternativas. Calcula el consumo en litros de tu vehículo (incluido Bi-Fuel GLP/GNC) y te sugiere la gasolinera más barata en ruta."
    },
    {
        icon: "🔔",
        title: "Alertas de Precios y Recordatorios",
        description: "Sigue tus gasolineras favoritas para recibir avisos por tipo de combustible cuando cambie el precio y activa recordatorios los días de la semana en que tus tarjetas tienen descuento."
    },
    {
        icon: "🚗",
        title: "Coste de Llenado, Lista y Navegación",
        description: "Consulta horarios de apertura, calcula cuánto cuesta llenar tu depósito (o un depósito estándar de 50 L), ordena estaciones por precio o distancia, comparte ofertas e inicia ruta en Google Maps, Waze o Apple Maps."
    }
];

const spanishDiscounts = [
    {
        name: "Waylet (Repsol, Campsa y Petronor)",
        type: "Cént./L o % configurable",
        details: "Aplica tu saldo o descuento por litro de Waylet directamente sobre los precios de Repsol, Campsa y Petronor en el mapa."
    },
    {
        name: "Más / Moeve (Cepsa) y Mi BP",
        type: "Descuento directo por litro",
        details: "Configura tus ventajas de Moeve Gow / Porque Tú Vuelves y Mi BP para comparar el coste real frente a gasolineras low cost."
    },
    {
        name: "Shell ClubSmart, Mundo Galp, DISA y AVIA",
        type: "Fidelización en 1 toque",
        details: "Plantillas listas para activar en un toque y personalizar según tu nivel de socio o promoción activa."
    },
    {
        name: "Carrefour, Alcampo, Eroski, BonÀrea y Esclat",
        type: "Supermercados y Cooperativas",
        details: "Calcula el precio neto descontando el porcentaje de acumulación del ChequeAhorro Carrefour, Eroski Club o tarjetas de hipermercado."
    }
];

const brands = [
    "Repsol", "Moeve (Cepsa)", "BP", "Galp", "Shell", "Petronor", "Campsa", "DISA",
    "Plenergy (Plenoil)", "Ballenoil", "Petroprix", "Carrefour", "Alcampo", "BonÀrea",
    "Esclat / Bonpreu", "Eroski", "Autonetoil", "Gasexpress", "Easygas", "Avia", "Q8",
    "Valcarce", "Meroil", "Tamoil", "Agla", "Eni"
];

const faqs = [
    {
        question: "¿De dónde proceden los precios de las gasolineras en Dónde Repostar?",
        answer: "Los precios se actualizan periódicamente a partir de los datos oficiales abiertos del Gobierno de España (Ministerio para la Transición Ecológica y el Reto Demográfico / Geoportal de Gasolineras) y se complementan con avisos de la comunidad de conductores."
    },
    {
        question: "¿Cómo funciona el cálculo de descuentos con Waylet, Moeve, Carrefour o BP?",
        answer: "En la pestaña Descuentos puedes elegir entre 14 plantillas de las principales marcas de España o crear tu propio descuento en céntimos por litro (cént./L) o porcentaje (%), indicando qué días de la semana aplica. El mapa recalcula automáticamente todos los marcadores con tu precio neto final."
    },
    {
        question: "¿Incluye gasolineras low cost como Plenergy (Plenoil), Ballenoil, Petroprix o BonÀrea?",
        answer: "Sí. Dónde Repostar muestra todas las estaciones de servicio de España, tanto redes tradicionales (Repsol, Moeve/Cepsa, BP, Shell, Galp, DISA) como gasolineras low cost y de supermercado (Plenergy, Ballenoil, Petroprix, Autonetoil, Gasexpress, Easygas, Carrefour, Alcampo, BonÀrea, Esclat y Eroski)."
    },
    {
        question: "¿Es necesario registrarse o crear una cuenta para usar la app?",
        answer: "No. Dónde Repostar es 100 % gratuita y anónima: puedes consultar el mapa, configurar tus vehículos, tarjetas de descuento, rutas y alertas sin necesidad de crear una cuenta ni facilitar datos personales."
    }
];

const structuredData = [
    {
        "@context": "https://schema.org",
        "@type": "MobileApplication",
        "name": "Dónde Repostar - Gasolineras España",
        "operatingSystem": "iOS, Android",
        "applicationCategory": "NavigationApplication",
        "description": appInfo.description,
        "url": "https://www.elmatecompany.com/donderepostar/",
        "image": "https://www.elmatecompany.com/assets/donderepostar/iconoDondeRepostar.png",
        "downloadUrl": [appInfo.storeLinks.apple, appInfo.storeLinks.google],
        "aggregateRating": {
            "@type": "AggregateRating",
            "ratingValue": "4.0",
            "ratingCount": "11"
        },
        "offers": {
            "@type": "Offer",
            "price": "0",
            "priceCurrency": "EUR"
        }
    },
    {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": faqs.map((faq) => ({
            "@type": "Question",
            "name": faq.question,
            "acceptedAnswer": {
                "@type": "Answer",
                "text": faq.answer
            }
        }))
    }
];
---

<Layout
    title="Dónde Repostar | Gasolineras Baratas, Precio Gasolina y Diésel Hoy en España"
    description={appInfo.description}
    appData={appInfo}
    lang="es-ES"
    keywords={appInfo.keywords}
    structuredData={structuredData}
>
    <!-- HERO SECTION -->
    <section class="pt-28 pb-14 px-4 max-w-5xl mx-auto text-center">
        <div class="inline-block mb-5">
            <img
                src={appInfo.logo}
                alt="Dónde Repostar - App de Gasolineras Baratas en España"
                width="112"
                height="112"
                class="w-28 h-28 mx-auto rounded-3xl shadow-xl border-2 border-gray-100 dark:border-gray-800"
            />
        </div>

        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-50 dark:bg-amber-950/60 border border-amber-200 dark:border-amber-800 text-amber-800 dark:text-amber-300 text-xs font-bold uppercase tracking-wider mb-4">
            <span>🇪🇸 Datos Oficiales del Ministerio (Geoportal) • iOS & Android</span>
        </div>

        <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight text-gray-900 dark:text-white mb-5">
            Dónde Repostar: <span class="text-amber-600 dark:text-amber-400">Gasolineras Más Baratas en España</span>
        </h1>

        <p class="text-lg md:text-xl font-semibold text-gray-700 dark:text-gray-200 mb-4 max-w-3xl mx-auto">
            {appInfo.tagline}
        </p>

        <p class="text-base md:text-lg text-gray-600 dark:text-gray-300 max-w-3xl mx-auto mb-8 leading-relaxed">
            {appInfo.description}
        </p>

        <!-- DOWNLOAD BUTTONS -->
        <div class="flex flex-col sm:flex-row gap-4 justify-center items-center max-w-lg mx-auto mb-8">
            <a
                href={appInfo.storeLinks.apple}
                target="_blank"
                rel="noopener noreferrer"
                class="w-full sm:w-auto flex items-center justify-center gap-3 bg-black text-white hover:bg-gray-800 font-bold px-8 py-4 rounded-2xl shadow-lg hover:scale-105 transition-all"
            >
                <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.37c.64-.78 1.08-1.86.96-2.95-1 .04-2.13.65-2.78 1.41-.58.67-.99 1.77-.87 2.83 1.12.09 2.05-.51 2.69-1.29z"/>
                </svg>
                <div class="text-left">
                    <div class="text-xs uppercase font-medium">Consíguelo en el</div>
                    <div class="text-sm font-bold">App Store (iOS)</div>
                </div>
            </a>

            <a
                href={appInfo.storeLinks.google}
                target="_blank"
                rel="noopener noreferrer"
                class="w-full sm:w-auto flex items-center justify-center gap-3 bg-amber-600 text-white hover:bg-amber-700 font-bold px-8 py-4 rounded-2xl shadow-lg hover:scale-105 transition-all"
            >
                <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M3.609 1.814L13.792 12 3.61 22.186a1.99 1.99 0 0 1-1.61-1.954V3.768c0-.825.602-1.535 1.609-1.954zm11.605 11.605l2.458 2.458-12.06 6.953 9.602-9.411zm0-2.838L5.612 1.17 17.672 8.12l-2.458 2.461zm1.414 1.419l3.541 2.043c.96.554.96 1.458 0 2.012l-3.541 2.043-2.122-2.123 2.122-2.975z"/>
                </svg>
                <div class="text-left">
                    <div class="text-xs uppercase font-medium">Disponible en</div>
                    <div class="text-sm font-bold">Google Play</div>
                </div>
            </a>
        </div>

        <!-- DESKTOP QR CODES -->
        <div class="hidden md:flex items-center justify-center gap-8 max-w-2xl mx-auto p-5 rounded-2xl bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 shadow-sm">
            <div class="flex items-center gap-3 text-left">
                <img
                    src={`https://api.qrserver.com/v1/create-qr-code/?size=160x160&data=${encodeURIComponent(appInfo.storeLinks.apple)}`}
                    alt="Código QR para descargar Dónde Repostar en iOS App Store"
                    width="88"
                    height="88"
                    loading="lazy"
                    class="w-22 h-22 rounded-xl border border-gray-200 p-1 bg-white"
                />
                <div>
                    <div class="text-xs font-bold uppercase text-gray-500 dark:text-gray-400">iPhone & iPad</div>
                    <div class="text-sm font-extrabold text-gray-900 dark:text-white">Escanea para App Store</div>
                    <div class="text-xs text-gray-500 dark:text-gray-400">Apunta con la cámara de tu móvil</div>
                </div>
            </div>
            <div class="h-14 w-px bg-gray-200 dark:bg-gray-800"></div>
            <div class="flex items-center gap-3 text-left">
                <img
                    src={`https://api.qrserver.com/v1/create-qr-code/?size=160x160&data=${encodeURIComponent(appInfo.storeLinks.google)}`}
                    alt="Código QR para descargar Dónde Repostar en Google Play"
                    width="88"
                    height="88"
                    loading="lazy"
                    class="w-22 h-22 rounded-xl border border-gray-200 p-1 bg-white"
                />
                <div>
                    <div class="text-xs font-bold uppercase text-amber-600 dark:text-amber-400">Móviles Android</div>
                    <div class="text-sm font-extrabold text-gray-900 dark:text-white">Escanea para Google Play</div>
                    <div class="text-xs text-gray-500 dark:text-gray-400">Descarga gratuita al instante</div>
                </div>
            </div>
        </div>
    </section>

    <!-- FEATURES GRID -->
    <section class="py-16 bg-gray-50 dark:bg-gray-900/50 border-y border-gray-200 dark:border-gray-800">
        <div class="max-w-5xl mx-auto px-4">
            <h2 class="text-3xl font-extrabold text-center text-gray-900 dark:text-white mb-4">
                Todo lo que Necesitas para Ahorrar al Repostar en España
            </h2>
            <p class="text-center text-gray-600 dark:text-gray-300 max-w-2xl mx-auto mb-12">
                Compara en segundos todas las estaciones de servicio de tu provincia con precios oficiales y tus tarjetas de fidelización aplicadas.
            </p>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                {features.map((feature) => (
                    <div class="bg-white dark:bg-gray-800 p-6 rounded-2xl border border-gray-200/80 dark:border-gray-700 shadow-sm hover:shadow-md transition-shadow">
                        <div class="text-4xl mb-4">{feature.icon}</div>
                        <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-2">{feature.title}</h3>
                        <p class="text-sm text-gray-600 dark:text-gray-300 leading-relaxed">{feature.description}</p>
                    </div>
                ))}
            </div>
        </div>
    </section>

    <!-- TARJETAS DE FIDELIZACIÓN Y MARCAS -->
    <section class="py-16 px-4 max-w-5xl mx-auto">
        <div class="bg-white dark:bg-gray-900 p-7 md:p-10 rounded-3xl border border-gray-200 dark:border-gray-800 shadow-sm">
            <h2 class="text-2xl md:text-3xl font-extrabold text-gray-900 dark:text-white mb-3 text-center">
                Calcula tu Precio Neto con Tarjetas de Descuento y Gasolineras Low Cost
            </h2>
            <p class="text-sm md:text-base text-gray-600 dark:text-gray-300 text-center max-w-3xl mx-auto mb-8">
                Configura tus tarjetas en un toque desde las plantillas integradas en la app (en céntimos/litro o porcentaje) para ver el precio final real directamente en cada marcador del mapa:
            </p>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-8">
                {spanishDiscounts.map((item) => (
                    <div class="p-4 rounded-2xl bg-gray-50 dark:bg-gray-800/70 border border-gray-200/70 dark:border-gray-700">
                        <div class="flex items-center justify-between gap-2 mb-1">
                            <span class="font-bold text-base text-gray-900 dark:text-white">{item.name}</span>
                            <span class="text-xs font-extrabold text-emerald-700 dark:text-emerald-400 bg-emerald-100 dark:bg-emerald-950/60 px-2.5 py-0.5 rounded-full whitespace-nowrap">
                                {item.type}
                            </span>
                        </div>
                        <p class="text-xs text-gray-600 dark:text-gray-300">{item.details}</p>
                    </div>
                ))}
            </div>

            <div class="border-t border-gray-200 dark:border-gray-800 pt-6">
                <h3 class="text-sm font-bold uppercase tracking-wider text-gray-500 dark:text-gray-400 text-center mb-4">
                    Más de 25 Redes y Gasolineras Low Cost Soportadas
                </h3>
                <div class="flex flex-wrap justify-center gap-2">
                    {brands.map((brand) => (
                        <span class="px-3 py-1 rounded-full text-xs font-semibold bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 border border-gray-200/60 dark:border-gray-700">
                            {brand}
                        </span>
                    ))}
                </div>
            </div>
        </div>
    </section>

    <!-- FAQ SECTION -->
    <section class="py-14 px-4 max-w-4xl mx-auto">
        <h2 class="text-3xl font-extrabold text-center text-gray-900 dark:text-white mb-10">
            Preguntas Frecuentes sobre Dónde Repostar
        </h2>
        <div class="space-y-4">
            {faqs.map((faq) => (
                <div class="bg-white dark:bg-gray-900 p-6 rounded-2xl border border-gray-200 dark:border-gray-800 shadow-sm">
                    <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-2">{faq.question}</h3>
                    <p class="text-sm text-gray-600 dark:text-gray-300 leading-relaxed">{faq.answer}</p>
                </div>
            ))}
        </div>
    </section>

    <!-- FOOTER BAR -->
    <section class="py-12 max-w-3xl mx-auto text-center px-4">
        <p class="text-sm text-gray-500 dark:text-gray-400 mb-4">
            Desarrollado por <strong>El Mate Company</strong> • <a href="/" class="hover:underline">Ver todas las aplicaciones</a>
        </p>
        <div class="flex justify-center gap-6 text-sm font-semibold">
            <a href="/terms" class="text-amber-600 dark:text-amber-400 hover:underline">
                Términos y Condiciones
            </a>
            <span class="text-gray-300 dark:text-gray-600">•</span>
            <a href="/privacy" class="text-amber-600 dark:text-amber-400 hover:underline">
                Política de Privacidad
            </a>
        </div>
    </section>
</Layout>
