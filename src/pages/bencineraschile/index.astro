---
import Layout from "../../layouts/Layout.astro";

const appInfo = {
    name: "Bencineras de Chile - Precio Bencina 93, 95, 97 y Diésel",
    tagline: "Encuentra la Bencina, Petróleo Diésel, GLP y GNC Más Baratos Cerca de Ti en Chile",
    description: "Compara precios oficiales de combustibles en Chile en tiempo real con datos públicos de la CNE (Bencina en Línea): Copec, Shell, Petrobras, Aramco, Gulf, Lipigas y Abastible. Diferencia precios entre Autoservicio y Asistido y aplica tus descuentos por día de la semana.",
    logo: "/assets/bencineraschile/iconobencineras.png",
    keywords: [
        "bencineras de chile",
        "precio bencina hoy chile",
        "bencina en linea app",
        "bencina mas barata cerca de mi",
        "precio gasolina 93 95 97 chile",
        "precio diesel hoy chile",
        "descuentos bencina chile",
        "copec shell petrobras aramco precios",
        "autoservicio bencina chile",
        "mapa bencineras chile",
        "precio glp vehicular chile"
    ],
    storeLinks: {
        google: "https://play.google.com/store/apps/details?id=com.app.bencineraschile"
    }
};

const features = [
    {
        icon: "⛽",
        title: "Precios Oficiales CNE (Bencina en Línea)",
        description: "Consulta precios actualizados de Gasolina 93, Gasolina 95, Gasolina 97, Petróleo Diésel, GLP Vehicular y GNC en todas las comunas y regiones de Chile."
    },
    {
        icon: "🤖",
        title: "Modalidad Autoservicio vs. Asistido",
        description: "Compara de un vistazo las tarifas diferenciadas entre surtidores de Autoservicio (Auto) y atención Asistida para Gasolina 93, 95, 97 y Diésel."
    },
    {
        icon: "💳",
        title: "Descuentos por Marca y Día de la Semana",
        description: "Configura tus descuentos en pesos por litro ($/L) o porcentaje (%) para Copec, Shell, Petrobras, Aramco y convenios bancarios o municipales, y mira el precio final rebajado en el mapa."
    },
    {
        icon: "📊",
        title: "Comparativa con el Promedio Regional",
        description: "Identifica al instante qué estaciones están por debajo del promedio de tu región y cuál ofrece el precio mínimo regional con marcadores por color."
    },
    {
        icon: "🚗",
        title: "Planificador de Rutas y Costo del Estanque",
        description: "Planifica tu viaje por Chile con opción de evitar peajes, revisa las bencineras en ruta y calcula cuánto cuesta llenar el estanque de tu auto (Gasolina, Diésel o Bi-Fuel GLP/GNC)."
    },
    {
        icon: "🛎️",
        title: "Servicios, Medios de Pago y Alertas",
        description: "Consulta horarios, medios de pago (efectivo, tarjetas, apps y billeteras digitales) y servicios como baño público, tienda de conveniencia, cajero automático, compresor de aire, lavado de autos y AdBlue, además de alertas de precios."
    }
];

const chileBenefits = [
    {
        name: "Copec, Shell, Petrobras y Aramco",
        badge: "Descuentos configurables",
        details: "Personaliza tus beneficios de apps como Muevo Copec, Mi Copiloto Shell o promociones de Petrobras y Aramco según el día de la semana."
    },
    {
        name: "Tarjetas Bancarias, Cajas y Municipalidades",
        badge: "$/L o % por día",
        details: "Añade tus descuentos de tarjetas de crédito/débito, cajas de compensación o convenios comunales y recibe un recordatorio el día que están activos."
    },
    {
        name: "Comparación Autoservicio vs. Asistido",
        badge: "Ahorro directo en surtidor",
        details: "Filtra específicamente por Gasolina 93/95/97 o Diésel en modalidad Autoservicio para encontrar el menor precio por litro sin esperar promociones."
    },
    {
        name: "GLP Vehicular y GNC en Todo Chile",
        badge: "Combustibles alternativos",
        details: "Mapa completo con estaciones de Lipigas, Abastible, Autogasco y surtidores de GLP y GNC compatibles con vehículos duales."
    }
];

const brands = [
    "Copec", "Shell", "Petrobras", "Aramco", "Gulf", "Lipigas",
    "Abastible", "Autogasco", "Custom Service", "Facaz", "HN",
    "Suárez Combustibles", "Bencineras Independientes"
];

const faqs = [
    {
        question: "¿De dónde se obtienen los precios de Bencineras de Chile?",
        answer: "La información de precios, servicios y estaciones se obtiene de fuentes públicas oficiales de la Comisión Nacional de Energía (CNE) del Gobierno de Chile a través del portal Bencina en Línea."
    },
    {
        question: "¿Cómo puedo ver mis descuentos de bancos o apps en el mapa?",
        answer: "En la sección Descuentos de la app puedes agregar tus promociones por marca (Copec, Shell, Petrobras, Aramco, etc.), eligiendo si el descuento es en pesos por litro ($/L) o porcentaje (%) y qué días de la semana aplica. El mapa mostrará automáticamente el precio con el descuento aplicado."
    },
    {
        question: "¿La app diferencia entre precios de Autoservicio y Atención Asistida?",
        answer: "Sí. En la ficha de cada bencinera puedes filtrar entre Todos, Asistido y Autoservicio para comparar exactamente la tarifa del surtidor que utilizas en Gasolina 93, 95, 97 y Diésel."
    },
    {
        question: "¿Necesito crear una cuenta para usar Bencineras de Chile?",
        answer: "No. La aplicación es 100 % gratuita y anónima: no solicita registro ni datos personales para consultar el mapa, guardar bencineras favoritas, configurar vehículos o recibir alertas."
    }
];

const structuredData = [
    {
        "@context": "https://schema.org",
        "@type": "MobileApplication",
        "name": "Bencineras de Chile",
        "operatingSystem": "Android",
        "applicationCategory": "NavigationApplication",
        "description": appInfo.description,
        "url": "https://www.elmatecompany.com/bencineraschile/",
        "image": "https://www.elmatecompany.com/assets/bencineraschile/iconobencineras.png",
        "downloadUrl": [appInfo.storeLinks.google],
        "aggregateRating": {
            "@type": "AggregateRating",
            "ratingValue": "5.0",
            "ratingCount": "1"
        },
        "offers": {
            "@type": "Offer",
            "price": "0",
            "priceCurrency": "CLP"
        }
    },
    {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": faqs.map((faq) => ({
            "@type": "Question",
            "name": faq.question,
            "acceptedAnswer": {
                "@type": "Answer",
                "text": faq.answer
            }
        }))
    }
];
---

<Layout
    title="Bencineras de Chile | Precio Bencina 93, 95, 97, Diésel y GLP Hoy (Datos CNE)"
    description={appInfo.description}
    appData={appInfo}
    lang="es-CL"
    keywords={appInfo.keywords}
    structuredData={structuredData}
>
    <!-- HERO SECTION -->
    <section class="pt-28 pb-14 px-4 max-w-5xl mx-auto text-center">
        <div class="inline-block mb-5">
            <img
                src={appInfo.logo}
                alt="Bencineras de Chile - App de Precios de Combustibles CNE"
                width="112"
                height="112"
                class="w-28 h-28 mx-auto rounded-3xl shadow-xl border-2 border-gray-100 dark:border-gray-800"
            />
        </div>

        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-red-50 dark:bg-red-950/60 border border-red-200 dark:border-red-800 text-red-700 dark:text-red-300 text-xs font-bold uppercase tracking-wider mb-4">
            <span>🇨🇱 Datos Oficiales CNE (Bencina en Línea) • Todo Chile</span>
        </div>

        <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight text-gray-900 dark:text-white mb-5">
            Bencineras de Chile: <span class="text-red-600 dark:text-red-400">Precio de Bencina y Diésel Hoy</span>
        </h1>

        <p class="text-lg md:text-xl font-semibold text-gray-700 dark:text-gray-200 mb-4 max-w-3xl mx-auto">
            {appInfo.tagline}
        </p>

        <p class="text-base md:text-lg text-gray-600 dark:text-gray-300 max-w-3xl mx-auto mb-8 leading-relaxed">
            {appInfo.description}
        </p>

        <!-- DOWNLOAD BUTTON -->
        <div class="flex flex-col sm:flex-row gap-4 justify-center items-center max-w-lg mx-auto mb-8">
            <a
                href={appInfo.storeLinks.google}
                target="_blank"
                rel="noopener noreferrer"
                class="w-full sm:w-auto flex items-center justify-center gap-3 bg-red-600 text-white hover:bg-red-700 font-bold px-8 py-4 rounded-2xl shadow-lg hover:scale-105 transition-all"
            >
                <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M3.609 1.814L13.792 12 3.61 22.186a1.99 1.99 0 0 1-1.61-1.954V3.768c0-.825.602-1.535 1.609-1.954zm11.605 11.605l2.458 2.458-12.06 6.953 9.602-9.411zm0-2.838L5.612 1.17 17.672 8.12l-2.458 2.461zm1.414 1.419l3.541 2.043c.96.554.96 1.458 0 2.012l-3.541 2.043-2.122-2.123 2.122-2.975z"/>
                </svg>
                <div class="text-left">
                    <div class="text-xs uppercase font-medium">Descargar gratis en</div>
                    <div class="text-sm font-bold">Google Play (Android)</div>
                </div>
            </a>
        </div>

        <!-- DESKTOP QR CODE -->
        <div class="hidden md:inline-flex items-center justify-center gap-4 mx-auto p-5 rounded-2xl bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 shadow-sm">
            <img
                src={`https://api.qrserver.com/v1/create-qr-code/?size=160x160&data=${encodeURIComponent(appInfo.storeLinks.google)}`}
                alt="Código QR para descargar Bencineras de Chile en Google Play"
                width="88"
                height="88"
                loading="lazy"
                class="w-22 h-22 rounded-xl border border-gray-200 p-1 bg-white"
            />
            <div class="text-left">
                <div class="text-xs font-bold uppercase text-red-600 dark:text-red-400">Celulares Android</div>
                <div class="text-sm font-extrabold text-gray-900 dark:text-white">Escanea para descargar en Google Play</div>
                <div class="text-xs text-gray-500 dark:text-gray-400">Apunta con la cámara de tu teléfono para instalar la app</div>
            </div>
        </div>
    </section>

    <!-- FEATURES GRID -->
    <section class="py-16 bg-gray-50 dark:bg-gray-900/50 border-y border-gray-200 dark:border-gray-800">
        <div class="max-w-5xl mx-auto px-4">
            <h2 class="text-3xl font-extrabold text-center text-gray-900 dark:text-white mb-4">
                Ahorra en Cada Carga de Bencina y Diésel en Todo Chile
            </h2>
            <p class="text-center text-gray-600 dark:text-gray-300 max-w-2xl mx-auto mb-12">
                Compara estaciones Copec, Shell, Petrobras, Aramco, Gulf, Lipigas y Abastible con datos oficiales y tus descuentos personalizados.
            </p>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                {features.map((feature) => (
                    <div class="bg-white dark:bg-gray-800 p-6 rounded-2xl border border-gray-200/80 dark:border-gray-700 shadow-sm hover:shadow-md transition-shadow">
                        <div class="text-4xl mb-4">{feature.icon}</div>
                        <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-2">{feature.title}</h3>
                        <p class="text-sm text-gray-600 dark:text-gray-300 leading-relaxed">{feature.description}</p>
                    </div>
                ))}
            </div>
        </div>
    </section>

    <!-- DESCUENTOS Y MODALIDADES -->
    <section class="py-16 px-4 max-w-5xl mx-auto">
        <div class="bg-white dark:bg-gray-900 p-7 md:p-10 rounded-3xl border border-gray-200 dark:border-gray-800 shadow-sm">
            <h2 class="text-2xl md:text-3xl font-extrabold text-gray-900 dark:text-white mb-3 text-center">
                Precios Autoservicio, Asistido y Descuentos por Día en el Mapa
            </h2>
            <p class="text-sm md:text-base text-gray-600 dark:text-gray-300 text-center max-w-3xl mx-auto mb-8">
                Configura las promociones de tus tarjetas o apps de combustible dentro de Bencineras de Chile para ver el precio final por litro directamente sobre cada estación:
            </p>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-8">
                {chileBenefits.map((item) => (
                    <div class="p-4 rounded-2xl bg-gray-50 dark:bg-gray-800/70 border border-gray-200/70 dark:border-gray-700">
                        <div class="flex items-center justify-between gap-2 mb-1">
                            <span class="font-bold text-base text-gray-900 dark:text-white">{item.name}</span>
                            <span class="text-xs font-extrabold text-emerald-700 dark:text-emerald-400 bg-emerald-100 dark:bg-emerald-950/60 px-2.5 py-0.5 rounded-full whitespace-nowrap">
                                {item.badge}
                            </span>
                        </div>
                        <p class="text-xs text-gray-600 dark:text-gray-300">{item.details}</p>
                    </div>
                ))}
            </div>

            <div class="border-t border-gray-200 dark:border-gray-800 pt-6">
                <h3 class="text-sm font-bold uppercase tracking-wider text-gray-500 dark:text-gray-400 text-center mb-4">
                    Marcas y Distribuidoras Soportadas en Chile
                </h3>
                <div class="flex flex-wrap justify-center gap-2">
                    {brands.map((brand) => (
                        <span class="px-3 py-1 rounded-full text-xs font-semibold bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 border border-gray-200/60 dark:border-gray-700">
                            {brand}
                        </span>
                    ))}
                </div>
            </div>
        </div>
    </section>

    <!-- FAQ SECTION -->
    <section class="py-14 px-4 max-w-4xl mx-auto">
        <h2 class="text-3xl font-extrabold text-center text-gray-900 dark:text-white mb-10">
            Preguntas Frecuentes sobre Bencineras de Chile
        </h2>
        <div class="space-y-4">
            {faqs.map((faq) => (
                <div class="bg-white dark:bg-gray-900 p-6 rounded-2xl border border-gray-200 dark:border-gray-800 shadow-sm">
                    <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-2">{faq.question}</h3>
                    <p class="text-sm text-gray-600 dark:text-gray-300 leading-relaxed">{faq.answer}</p>
                </div>
            ))}
        </div>
    </section>

    <!-- FOOTER BAR -->
    <section class="py-12 max-w-3xl mx-auto text-center px-4">
        <p class="text-sm text-gray-500 dark:text-gray-400 mb-4">
            Desarrollado por <strong>El Mate Company</strong> • <a href="/" class="hover:underline">Ver todas las aplicaciones</a>
        </p>
        <div class="flex justify-center gap-6 text-sm font-semibold">
            <a href="/terms" class="text-red-600 dark:text-red-400 hover:underline">
                Términos y Condiciones
            </a>
            <span class="text-gray-300 dark:text-gray-600">•</span>
            <a href="/privacy" class="text-red-600 dark:text-red-400 hover:underline">
                Política de Privacidad
            </a>
        </div>
    </section>
</Layout>
