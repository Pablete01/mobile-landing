---
import Layout from "../../layouts/Layout.astro";

const appInfo = {
    name: "Donde cargAR - Precios de Nafta, Gasoil, GNC y EV",
    tagline: "Encontrá la Nafta, Gasoil, GNC y Cargadores Eléctricos Más Baratos en Argentina",
    description: "Compará precios de combustibles hoy en Argentina en tiempo real: YPF, Shell, Axion, Puma, Gulf, Dapsa y Refinor. Calculá el precio neto con descuentos de YPF App, Shell Box, Axion ON, Puma Pris, MODO y bancos (+220.000 descargas).",
    logo: "/assets/dondecargar/iconoDondeCargar.png",
    keywords: [
        "precio nafta hoy argentina",
        "donde cargar",
        "precio nafta ypf hoy",
        "precio nafta shell hoy",
        "precio gnc hoy",
        "descuentos combustible hoy",
        "ypf app descuento",
        "shell box descuento miercoles",
        "axion on descuento",
        "mapa estaciones de servicio argentina",
        "cargadores electricos argentina mapa",
        "ahorrar nafta argentina"
    ],
    storeLinks: {
        apple: "https://apps.apple.com/ar/app/id6738704543",
        google: "https://play.google.com/store/apps/details?id=com.app.dondecargar"
    }
};

const features = [
    {
        icon: "⛽",
        title: "Precios de Nafta, Gasoil y GNC al Día",
        description: "Consultá precios oficiales y confirmados por la comunidad de conductores para Nafta Súper, Nafta Premium (Infinia / V-Power / Quantium), Gasoil, Diésel Premium y GNC en todo el país."
    },
    {
        icon: "💳",
        title: "Descuentos en 1 Toque y Precio Neto",
        description: "Activá YPF App, Shell Box, ON de Axion, Puma Pris, MODO, Mercado Pago y promociones bancarias. El mapa calcula automáticamente el precio final por litro considerando el porcentaje y tope de reintegro."
    },
    {
        icon: "🔔",
        title: "Recordatorios Matutinos a las 9:00 hs",
        description: "Recibí un aviso automático el día que aplica tu descuento con el precio estimado en tu estación de servicio favorita."
    },
    {
        icon: "🛣️",
        title: "Optimizador de Rutas y Paradas",
        description: "Planificá tu viaje por ruta en Argentina: calculamos tu autonomía real (Nafta, Diésel, Dual Nafta + GNC o 100% Eléctrico) y te sugerimos en qué estación conviene parar a cargar."
    },
    {
        icon: "⚡",
        title: "Mapa de Cargadores Eléctricos (EV)",
        description: "Modo EV dedicado con puntos de carga para autos eléctricos e híbridos enchufables, filtrando por tipo de conector (CCS2, Tipo 2, CHAdeMO) y potencia en kW."
    },
    {
        icon: "📓",
        title: "Libro de Cargas, Consumo Real y Reportes PDF",
        description: "Registrá tus cargas, medí el rendimiento real de tu vehículo en km/L, km/m³ o kWh/100 km, exportá reportes en PDF y guardá copias de seguridad."
    }
];

const promoPresets = [
    {
        name: "YPF App",
        brand: "YPF",
        saving: "Promos vigentes en la App",
        details: "Descuentos en Infinia Nafta, Infinia Diésel y beneficios Serviclub con topes y días actualizados en la aplicación."
    },
    {
        name: "Shell Box",
        brand: "Shell",
        saving: "Promos vigentes en la App",
        details: "Ahorro en combustibles Shell V-Power con tope semanal y acumulación con promociones bancarias configurables."
    },
    {
        name: "ON de AXION",
        brand: "Axion Energy",
        saving: "Promos vigentes en la App",
        details: "Descuentos en Quantium Nafta y Quantium Diésel según tu nivel y día de promoción en el programa ON."
    },
    {
        name: "Puma Pris",
        brand: "Puma Energy",
        saving: "Promos vigentes en la App",
        details: "Ahorro semanal en Nafta Súper, Max Premium e Ion Diésel y suma de puntos desde la app Puma Pris."
    },
    {
        name: "MODO, Billeteras y Bancos",
        brand: "Todas las banderas",
        saving: "Reintegros actualizados",
        details: "Reintegros pagando con QR MODO, BNA+, Mercado Pago, Galicia, Santander, BBVA, Macro y tarjetas de crédito/débito."
    }
];

const faqs = [
    {
        question: "¿Cómo saber dónde está la nafta o el GNC más barato cerca mío en Argentina?",
        answer: "Con la app gratuita Donde cargAR (+220.000 descargas en Argentina) podés ver en el mapa interactivo todas las estaciones YPF, Shell, Axion, Puma, Gulf, Voy, Dapsa y Refinor ordenadas por precio. Los marcadores se pintan de verde (más baratas) a rojo (más caras) en tiempo real."
    },
    {
        question: "¿Cómo calcula Donde cargAR los descuentos con tope de reintegro?",
        answer: "Cuando activás tus tarjetas o apps (YPF App, Shell Box, Axion ON, Puma Pris, MODO o tu banco) e indicás la capacidad del tanque de tu auto, la app calcula el descuento efectivo real por litro teniendo en cuenta el porcentaje de descuento, el día de la semana y el tope máximo de reintegro en pesos."
    },
    {
        question: "¿Funciona para autos con GNC y vehículos eléctricos (EV)?",
        answer: "Sí. Podés configurar un vehículo Dual (Nafta + GNC) para comparar tanto el m³ de GNC como el litro de nafta y calcular tu autonomía combinada en ruta, o activar el Modo EV para ver cargadores eléctricos en toda Argentina."
    }
];

const structuredData = [
    {
        "@context": "https://schema.org",
        "@type": "MobileApplication",
        "name": "Donde cargAR",
        "operatingSystem": "iOS, Android",
        "applicationCategory": "NavigationApplication",
        "description": appInfo.description,
        "url": "https://www.elmatecompany.com/dondecargar/",
        "image": "https://www.elmatecompany.com/assets/dondecargar/iconoDondeCargar.png",
        "downloadUrl": [appInfo.storeLinks.apple, appInfo.storeLinks.google],
        "aggregateRating": {
            "@type": "AggregateRating",
            "ratingValue": "3.8",
            "ratingCount": "593"
        },
        "offers": {
            "@type": "Offer",
            "price": "0",
            "priceCurrency": "ARS"
        }
    },
    {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": faqs.map((faq) => ({
            "@type": "Question",
            "name": faq.question,
            "acceptedAnswer": {
                "@type": "Answer",
                "text": faq.answer
            }
        }))
    }
];
---

<Layout
    title="Donde cargAR | Precio de la Nafta, Gasoil y GNC Hoy en Argentina"
    description={appInfo.description}
    appData={appInfo}
    lang="es-AR"
    keywords={appInfo.keywords}
    structuredData={structuredData}
>
    <!-- HERO SECTION -->
    <section class="pt-28 pb-14 px-4 max-w-5xl mx-auto text-center">
        <div class="inline-block mb-5">
            <img
                src={appInfo.logo}
                alt="Donde cargAR - App de Precios de Combustibles en Argentina"
                width="112"
                height="112"
                class="w-28 h-28 mx-auto rounded-3xl shadow-xl border-2 border-gray-100 dark:border-gray-800"
            />
        </div>

        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-sky-50 dark:bg-sky-950/60 border border-sky-200 dark:border-sky-800 text-sky-700 dark:text-sky-300 text-xs font-bold uppercase tracking-wider mb-4">
            <span>🇦🇷 +220.000 Descargas en Argentina • Datos Oficiales + Comunidad</span>
        </div>

        <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight text-gray-900 dark:text-white mb-5">
            Donde cargAR: <span class="text-sky-600 dark:text-sky-400">Precios de Nafta, Gasoil y GNC Hoy</span>
        </h1>

        <p class="text-lg md:text-xl font-semibold text-gray-700 dark:text-gray-200 mb-4 max-w-3xl mx-auto">
            {appInfo.tagline}
        </p>

        <p class="text-base md:text-lg text-gray-600 dark:text-gray-300 max-w-3xl mx-auto mb-8 leading-relaxed">
            {appInfo.description}
        </p>

        <!-- DOWNLOAD BUTTONS -->
        <div class="flex flex-col sm:flex-row gap-4 justify-center items-center max-w-lg mx-auto mb-8">
            <a
                href={appInfo.storeLinks.apple}
                target="_blank"
                rel="noopener noreferrer"
                class="w-full sm:w-auto flex items-center justify-center gap-3 bg-black text-white hover:bg-gray-800 font-bold px-8 py-4 rounded-2xl shadow-lg hover:scale-105 transition-all"
            >
                <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.37c.64-.78 1.08-1.86.96-2.95-1 .04-2.13.65-2.78 1.41-.58.67-.99 1.77-.87 2.83 1.12.09 2.05-.51 2.69-1.29z"/>
                </svg>
                <div class="text-left">
                    <div class="text-xs uppercase font-medium">Descargar en</div>
                    <div class="text-sm font-bold">App Store (iOS)</div>
                </div>
            </a>

            <a
                href={appInfo.storeLinks.google}
                target="_blank"
                rel="noopener noreferrer"
                class="w-full sm:w-auto flex items-center justify-center gap-3 bg-sky-600 text-white hover:bg-sky-700 font-bold px-8 py-4 rounded-2xl shadow-lg hover:scale-105 transition-all"
            >
                <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M3.609 1.814L13.792 12 3.61 22.186a1.99 1.99 0 0 1-1.61-1.954V3.768c0-.825.602-1.535 1.609-1.954zm11.605 11.605l2.458 2.458-12.06 6.953 9.602-9.411zm0-2.838L5.612 1.17 17.672 8.12l-2.458 2.461zm1.414 1.419l3.541 2.043c.96.554.96 1.458 0 2.012l-3.541 2.043-2.122-2.123 2.122-2.975z"/>
                </svg>
                <div class="text-left">
                    <div class="text-xs uppercase font-medium">Disponible en</div>
                    <div class="text-sm font-bold">Google Play</div>
                </div>
            </a>
        </div>

        <div class="mb-8">
            <a
                href="https://www.dondecargar.app"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 text-sm font-bold text-sky-600 dark:text-sky-400 hover:text-sky-700 dark:hover:text-sky-300 underline underline-offset-4"
            >
                Visitar sitio web oficial y portal para estaciones: www.dondecargar.app →
            </a>
        </div>

        <!-- DESKTOP QR CODES -->
        <div class="hidden md:flex items-center justify-center gap-8 max-w-2xl mx-auto p-5 rounded-2xl bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 shadow-sm">
            <div class="flex items-center gap-3 text-left">
                <img
                    src={`https://api.qrserver.com/v1/create-qr-code/?size=160x160&data=${encodeURIComponent(appInfo.storeLinks.apple)}`}
                    alt="Código QR para descargar Donde cargAR en iOS App Store"
                    width="88"
                    height="88"
                    loading="lazy"
                    class="w-22 h-22 rounded-xl border border-gray-200 p-1 bg-white"
                />
                <div>
                    <div class="text-xs font-bold uppercase text-gray-500 dark:text-gray-400">iPhone & iPad</div>
                    <div class="text-sm font-extrabold text-gray-900 dark:text-white">Escaneá para App Store</div>
                    <div class="text-xs text-gray-500 dark:text-gray-400">Apuntá con la cámara de tu celular</div>
                </div>
            </div>
            <div class="h-14 w-px bg-gray-200 dark:bg-gray-800"></div>
            <div class="flex items-center gap-3 text-left">
                <img
                    src={`https://api.qrserver.com/v1/create-qr-code/?size=160x160&data=${encodeURIComponent(appInfo.storeLinks.google)}`}
                    alt="Código QR para descargar Donde cargAR en Google Play"
                    width="88"
                    height="88"
                    loading="lazy"
                    class="w-22 h-22 rounded-xl border border-gray-200 p-1 bg-white"
                />
                <div>
                    <div class="text-xs font-bold uppercase text-sky-600 dark:text-sky-400">Celulares Android</div>
                    <div class="text-sm font-extrabold text-gray-900 dark:text-white">Escaneá para Google Play</div>
                    <div class="text-xs text-gray-500 dark:text-gray-400">Descarga gratuita al instante</div>
                </div>
            </div>
        </div>
    </section>

    <!-- FEATURES GRID -->
    <section class="py-16 bg-gray-50 dark:bg-gray-900/50 border-y border-gray-200 dark:border-gray-800">
        <div class="max-w-5xl mx-auto px-4">
            <h2 class="text-3xl font-extrabold text-center text-gray-900 dark:text-white mb-4">
                La App Líder en Argentina para Ahorrar en Cada Carga
            </h2>
            <p class="text-center text-gray-600 dark:text-gray-300 max-w-2xl mx-auto mb-12">
                Compará estaciones YPF, Shell, Axion, Puma, Gulf, Dapsa, Voy y Refinor en todo el país con precios actualizados y descuentos reales.
            </p>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                {features.map((feature) => (
                    <div class="bg-white dark:bg-gray-800 p-6 rounded-2xl border border-gray-200/80 dark:border-gray-700 shadow-sm hover:shadow-md transition-shadow">
                        <div class="text-4xl mb-4">{feature.icon}</div>
                        <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-2">{feature.title}</h3>
                        <p class="text-sm text-gray-600 dark:text-gray-300 leading-relaxed">{feature.description}</p>
                    </div>
                ))}
            </div>
        </div>
    </section>

    <!-- PROMOCIONES Y DESCUENTOS EN COMBUSTIBLE -->
    <section class="py-16 px-4 max-w-5xl mx-auto">
        <div class="bg-white dark:bg-gray-900 p-7 md:p-10 rounded-3xl border border-gray-200 dark:border-gray-800 shadow-sm">
            <h2 class="text-2xl md:text-3xl font-extrabold text-gray-900 dark:text-white mb-3 text-center">
                Descuentos en Combustible Hoy: YPF App, Shell Box, Axion ON, Puma Pris y MODO
            </h2>
            <p class="text-sm md:text-base text-gray-600 dark:text-gray-300 text-center max-w-3xl mx-auto mb-8">
                Activá tus programas de beneficios y bancos en 1 toque dentro de Donde cargAR para ver el <strong>precio neto por litro con tope aplicado</strong> directamente sobre cada estación del mapa:
            </p>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                {promoPresets.map((item) => (
                    <div class="p-4 rounded-2xl bg-gray-50 dark:bg-gray-800/70 border border-gray-200/70 dark:border-gray-700">
                        <div class="flex items-center justify-between mb-1">
                            <span class="font-bold text-base text-gray-900 dark:text-white">{item.name} ({item.brand})</span>
                            <span class="text-xs font-extrabold text-emerald-700 dark:text-emerald-400 bg-emerald-100 dark:bg-emerald-950/60 px-2.5 py-0.5 rounded-full">
                                {item.saving}
                            </span>
                        </div>
                        <p class="text-xs text-gray-600 dark:text-gray-300">{item.details}</p>
                    </div>
                ))}
            </div>
        </div>
    </section>

    <!-- FAQ SECTION -->
    <section class="py-14 px-4 max-w-4xl mx-auto">
        <h2 class="text-3xl font-extrabold text-center text-gray-900 dark:text-white mb-10">
            Preguntas Frecuentes sobre Donde cargAR
        </h2>
        <div class="space-y-4">
            {faqs.map((faq) => (
                <div class="bg-white dark:bg-gray-900 p-6 rounded-2xl border border-gray-200 dark:border-gray-800 shadow-sm">
                    <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-2">{faq.question}</h3>
                    <p class="text-sm text-gray-600 dark:text-gray-300 leading-relaxed">{faq.answer}</p>
                </div>
            ))}
        </div>
    </section>

    <!-- FOOTER BAR -->
    <section class="py-12 max-w-3xl mx-auto text-center px-4">
        <p class="text-sm text-gray-500 dark:text-gray-400 mb-4">
            Desarrollado por <strong>El Mate Company</strong> • <a href="/" class="hover:underline">Ver todas las aplicaciones</a>
        </p>
        <div class="flex justify-center gap-6 text-sm font-semibold">
            <a href="/terms" class="text-sky-600 dark:text-sky-400 hover:underline">
                Términos y Condiciones
            </a>
            <span class="text-gray-300 dark:text-gray-600">•</span>
            <a href="/privacy" class="text-sky-600 dark:text-sky-400 hover:underline">
                Política de Privacidad
            </a>
        </div>
    </section>
</Layout>
