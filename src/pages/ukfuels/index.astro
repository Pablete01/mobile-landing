    <script is:inline>
        (function () {
            const UK_GALLON_LITRES = 4.54609;
            const US_GALLON_LITRES = 3.78541;
            const input = document.getElementById("uk-ppl-input");
            const ukGalOut = document.getElementById("uk-gal-out");
            const ukLitreOut = document.getElementById("uk-litre-out");
            const ukTankOut = document.getElementById("uk-tank-out");
            const ukTank55Out = document.getElementById("uk-tank55-out");
            const usGalOut = document.getElementById("us-gal-out");
            const ukCpmOut = document.getElementById("uk-cpm-out");
            const presetBtns = document.querySelectorAll(".uk-preset-btn");

            function updateCalc(pplValue) {
                const ppl = parseFloat(pplValue);
                if (isNaN(ppl) || ppl <= 0) return;
                const poundsPerLitre = ppl / 100;
                const poundsPerUkGal = poundsPerLitre * UK_GALLON_LITRES;
                const poundsPerUsGal = poundsPerLitre * US_GALLON_LITRES;
                const tank50 = poundsPerLitre * 50;
                const tank55 = poundsPerLitre * 55;
                const costPerMilePence = (ppl * UK_GALLON_LITRES) / 40;

                if (ukGalOut) ukGalOut.textContent = "£" + poundsPerUkGal.toFixed(2);
                if (ukLitreOut) ukLitreOut.textContent = "£" + poundsPerLitre.toFixed(2);
                if (ukTankOut) ukTankOut.textContent = "£" + tank50.toFixed(2);
                if (ukTank55Out) ukTank55Out.textContent = "£" + tank55.toFixed(2);
                if (usGalOut) usGalOut.textContent = "£" + poundsPerUsGal.toFixed(2);
                if (ukCpmOut) ukCpmOut.textContent = costPerMilePence.toFixed(1) + "p";
            }

            if (input) {
                input.addEventListener("input", function (e) {
                    updateCalc(e.target.value);
                });
            }

            presetBtns.forEach(function (btn) {
                btn.addEventListener("click", function () {
                    const val = btn.getAttribute("data-ppl");
                    if (val && input) {
                        input.value = val;
                        updateCalc(val);
                    }
                });
            });
        })();
    </script>
</Layout>
