---
import Layout from "../../layouts/Layout.astro";
import { appData as siteData } from "../../data";

const appInfo = {
    name: "UK Fuel Prices & Petrol Map",
    tagline: "Find the Cheapest Petrol, Diesel & EV Chargers Across the UK",
    description: "Compare real-time fuel prices from thousands of stations nationwide. Save money on every fill-up with smart route pitstops, personal garage tracking, and instant price alerts.",
    logo: "/assets/ukfuels/iconoUKFuels.png",
    storeLinks: {
        apple: "https://apps.apple.com/app/id6759508195",
        google: "https://play.google.com/store/apps/details?id=com.app.ukfuelprices"
    }
};

const features = [
    {
        icon: "⛽",
        title: "Live Fuel Prices",
        description: "Accurate, daily-updated prices for Unleaded (E10), Super Unleaded (E5), Standard Diesel (B7), Premium Diesel, and alternative fuels."
    },
    {
        icon: "🗺️",
        title: "Interactive Smart Map",
        description: "Visual colour-coded station pins help you spot the cheapest petrol stations in your area at a single glance."
    },
    {
        icon: "🛣️",
        title: "Route Optimizer & Pitstops",
        description: "Planning a road trip? Calculate the optimal refueling stop along your journey to avoid overpriced motorway service stations."
    },
    {
        icon: "🚗",
        title: "Garage & Fuel Logbook",
        description: "Register your vehicles, track average MPG or L/100 km, calculate full tank range, and log all fuel expenses with ease."
    },
    {
        icon: "⚡",
        title: "EV Charging Stations",
        description: "Locate electric vehicle charging points with live availability, power levels (kW), and compatible connector types."
    },
    {
        icon: "🔒",
        title: "100% Anonymous & Private",
        description: "No account required. Your vehicle garage and fuel logs stay securely on your personal device."
    }
];
---

<Layout 
  title={`${appInfo.name} | El Mate Company`} 
  description={appInfo.description}
  appData={siteData}
>
    <!-- HERO SECTION -->
    <section class="pt-32 pb-20 px-4 max-w-5xl mx-auto text-center">
        <div class="inline-block mb-6">
            <img 
                src={appInfo.logo} 
                alt={appInfo.name} 
                class="w-28 h-28 mx-auto rounded-3xl shadow-xl border-2 border-gray-100 dark:border-gray-800"
            />
        </div>

        <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight text-gray-900 dark:text-white mb-6">
            {appInfo.name}
        </h1>

        <p class="text-xl md:text-2xl font-semibold text-blue-600 dark:text-blue-400 mb-4 max-w-2xl mx-auto">
            {appInfo.tagline}
        </p>

        <p class="text-base md:text-lg text-gray-600 dark:text-gray-300 max-w-2xl mx-auto mb-10 leading-relaxed">
            {appInfo.description}
        </p>

        <!-- DOWNLOAD BUTTONS -->
        <div class="flex flex-col sm:flex-row gap-4 justify-center items-center max-w-md mx-auto mb-16">
            <a 
                href={appInfo.storeLinks.apple} 
                target="_blank" 
                rel="noopener noreferrer"
                class="w-full sm:w-auto flex items-center justify-center gap-3 bg-black text-white hover:bg-gray-800 font-bold px-8 py-4 rounded-2xl shadow-lg hover:scale-105 transition-all"
            >
                <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
                    <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.37c.64-.78 1.08-1.86.96-2.95-1 .04-2.13.65-2.78 1.41-.58.67-.99 1.77-.87 2.83 1.12.09 2.05-.51 2.69-1.29z"/>
                </svg>
                <div class="text-left">
                    <div class="text-xs uppercase font-medium">Download on the</div>
                    <div class="text-sm font-bold">App Store</div>
                </div>
            </a>

            <a 
                href={appInfo.storeLinks.google} 
                target="_blank" 
                rel="noopener noreferrer"
                class="w-full sm:w-auto flex items-center justify-center gap-3 bg-blue-600 text-white hover:bg-blue-700 font-bold px-8 py-4 rounded-2xl shadow-lg hover:scale-105 transition-all"
            >
                <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
                    <path d="M3.609 1.814L13.792 12 3.61 22.186a1.99 1.99 0 0 1-1.61-1.954V3.768c0-.825.602-1.535 1.609-1.954zm11.605 11.605l2.458 2.458-12.06 6.953 9.602-9.411zm0-2.838L5.612 1.17 17.672 8.12l-2.458 2.461zm1.414 1.419l3.541 2.043c.96.554.96 1.458 0 2.012l-3.541 2.043-2.122-2.123 2.122-2.975z"/>
                </svg>
                <div class="text-left">
                    <div class="text-xs uppercase font-medium">Get it on</div>
                    <div class="text-sm font-bold">Google Play</div>
                </div>
            </a>
        </div>
    </section>

    <!-- FEATURES GRID -->
    <section class="py-16 bg-gray-50 dark:bg-gray-900/50 border-y border-gray-200 dark:border-gray-800">
        <div class="max-w-5xl mx-auto px-4">
            <h2 class="text-3xl font-extrabold text-center text-gray-900 dark:text-white mb-12">
                Designed to Save You Time & Money
            </h2>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                {features.map((feature) => (
                    <div class="bg-white dark:bg-gray-800 p-6 rounded-2xl border border-gray-200/80 dark:border-gray-700 shadow-sm hover:shadow-md transition-shadow">
                        <div class="text-4xl mb-4">{feature.icon}</div>
                        <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-2">{feature.title}</h3>
                        <p class="text-sm text-gray-600 dark:text-gray-300 leading-relaxed">{feature.description}</p>
                    </div>
                ))}
            </div>
        </div>
    </section>

    <!-- LEGAL LINKS FOOTER BAR -->
    <section class="py-12 max-w-3xl mx-auto text-center px-4">
        <p class="text-sm text-gray-500 dark:text-gray-400 mb-4">
            Developed by <strong>El Mate Company</strong>
        </p>
        <div class="flex justify-center gap-6 text-sm font-semibold">
            <a href="/ukfuels/terms" class="text-blue-600 dark:text-blue-400 hover:underline">
                Terms and Conditions (EULA)
            </a>
            <span class="text-gray-300 dark:text-gray-600">•</span>
            <a href="/ukfuels/privacy" class="text-blue-600 dark:text-blue-400 hover:underline">
                Privacy Policy
            </a>
        </div>
    </section>
</Layout>
