---
// Código del servidor (Frontmatter)
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Matech - El primer mate inteligente</title>
    
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    
    <style>
      /* --- ESTILO PORTFOLIO (Sleek Dark Mode) --- */
      :root {
        --primary-color: #10b981; 
        --bg-color: #0f172a;      
        --surface-color: #1e293b; 
        --text-main: #f8fafc;     
        --text-muted: #94a3b8;    
        --border-color: #334155;  
      }
      
      body {
        font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        margin: 0;
        padding: 0;
        background-color: var(--bg-color);
        color: var(--text-main);
        line-height: 1.6;
      }

      .container {
        max-width: 1000px;
        margin: 0 auto;
        padding: 0 20px;
      }

      /* HERO */
      .hero {
        text-align: center;
        padding: 100px 20px 60px;
        position: relative;
      }
      .hero h1 {
        font-size: 3.5rem;
        margin-bottom: 10px;
        color: var(--text-main);
        letter-spacing: -1px;
      }
      .hero h1 span {
        color: var(--primary-color);
      }
      .hero p {
        font-size: 1.2rem;
        color: var(--text-muted);
        max-width: 600px;
        margin: 0 auto;
      }

      /* BOTÓN VOLVER */
      .btn-volver-raiz {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 16px;
        background-color: var(--surface-color);
        color: var(--text-main);
        text-decoration: none;
        font-weight: 600;
        font-size: 0.9rem;
        border-radius: 50px;
        border: 1px solid var(--border-color);
        transition: all 0.3s ease;
        position: absolute; 
        top: 24px;
        left: 24px;
        margin: 0; 
        z-index: 10;
      }
      .btn-volver-raiz:hover {
        background-color: var(--border-color);
        color: var(--primary-color);
      }

      /* SOBRE EL PROYECTO */
      .about-project {
        background: var(--surface-color);
        padding: 40px;
        border-radius: 16px;
        border: 1px solid var(--border-color);
        margin-bottom: 60px;
        text-align: center;
      }
      .about-project h2 { margin-top: 0; color: var(--text-main); }
      .about-project p { color: var(--text-muted); }
      .about-project b { color: var(--primary-color); }

      /* MAPA */
      .map-section {
        margin-bottom: 60px;
        background: var(--surface-color);
        padding: 30px;
        border-radius: 16px;
        border: 1px solid var(--border-color);
      }
      .map-section h2 {
        text-align: center;
        margin-top: 0;
        margin-bottom: 10px;
      }
      .map-subtitle {
        text-align: center; 
        color: var(--text-muted); 
        margin-bottom: 25px;
        font-size: 0.95rem;
      }
      #mapa-matech {
        height: 450px;
        width: 100%;
        border-radius: 12px;
        z-index: 1; 
      }

      /* GALERÍA MÁS CHICA */
      .gallery-section {
        margin-bottom: 80px;
      }
      .gallery-section h2 {
        text-align: center;
        margin-bottom: 30px;
      }
      .gallery-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); 
        gap: 20px;
        align-items: center; 
      }
      .gallery-photo {
        width: 100%;
        height: 180px; 
        object-fit: cover; 
        border-radius: 12px;
        border: 1px solid var(--border-color);
        transition: transform 0.3s ease, border-color 0.3s ease;
        cursor: zoom-in;
      }
      .gallery-photo:hover {
        transform: scale(1.05);
        border-color: var(--primary-color);
      }

      /* LIGHTBOX */
      .lightbox {
        display: none; 
        position: fixed;
        z-index: 9999; 
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(15, 23, 42, 0.95); 
        align-items: center;
        justify-content: center;
        cursor: zoom-out; 
      }
      .lightbox img {
        max-width: 90%;
        max-height: 90%;
        border-radius: 8px;
        box-shadow: 0 10px 40px rgba(0,0,0,0.8);
        animation: aparecer 0.2s ease-out; 
      }
      .lightbox-cerrar {
        position: absolute;
        top: 20px;
        right: 30px;
        color: white;
        font-size: 40px;
        font-weight: bold;
        cursor: pointer;
      }

      @keyframes aparecer {
        from { opacity: 0; transform: scale(0.95); }
        to { opacity: 1; transform: scale(1); }
      }

      footer {
        text-align: center;
        padding: 40px 20px;
        color: var(--text-muted);
        border-top: 1px solid var(--border-color);
      }
      
      /* Ajuste Leaflet popup para Dark Mode */
      .leaflet-popup-content-wrapper, .leaflet-popup-tip {
        background: var(--surface-color);
        color: var(--text-main);
      }
    </style>
  </head>
  <body>
    
    <header class="hero">
      <a href="/" class="btn-volver-raiz">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M19 12H5M12 19l-7-7 7-7"/>
        </svg>
        Volver
      </a>
      <h1>Ma<span>tech</span></h1>
      <p>El mate inteligente IoT que conecta la tradición con la telemetría en la nube.</p>
    </header>

    <div class="container">
      <section class="about-project">
        <h2>¿Qué hay bajo el capó?</h2>
        <p>
          Matech no es solo un mate. Es un sistema completo impulsado por un microcontrolador <b>ESP32</b> 
          con sensores de temperatura y pantallas LCD. Se conecta vía Bluetooth a una aplicación nativa en <b>Android (Kotlin + Jetpack Compose)</b>, 
          registrando las rondas de mate, calculando estadísticas en tiempo real y enviando la telemetría a <b>Firebase Firestore</b>.
        </p>
      </section>

      <section class="map-section">
        <h2>📍 Rondas Globales</h2>
        <p class="map-subtitle">Cada pin representa una ronda terminada y sincronizada por un usuario.</p>
        <div id="mapa-matech"></div>
      </section>

      <section class="gallery-section">
        <h2>En Laboratorio 🧉</h2>
        <div class="gallery-grid">
          <img src="/assets/matech/mate44.webp" alt="Captura de la aplicación Android" class="gallery-photo" />       
          <img src="/assets/matech/mate11.webp" alt="Hardware y ESP32" class="gallery-photo" />        
          <img src="/assets/matech/mate22.webp" alt="Desarrollo Android" class="gallery-photo" />
          <img src="/assets/matech/mate33.webp" alt="Tecnología IoT" class="gallery-photo" />
          <img src="/assets/matech/mate77.webp" alt="Telemetría en app" class="gallery-photo" />
          <img src="/assets/matech/mate66.webp" alt="Ronda finalizada" class="gallery-photo" />
        </div>
      </section>
    </div>

    <footer>
      <p>Desarrollado con 💻 y 🧉. Construido con Astro, Kotlin y Firebase.</p>
    </footer>

    <div id="lightbox" class="lightbox">
      <span class="lightbox-cerrar">&times;</span>
      <img id="lightbox-img" src="" alt="Imagen ampliada" />
    </div>

    <script>
      // Importaciones necesarias (Esto es lo que evitaba el error de TypeScript)
      import L from "leaflet";
      import { initializeApp } from "firebase/app";
      import { getFirestore, collection, getDocs } from "firebase/firestore";

      // 1. LÓGICA DEL LIGHTBOX
      const lightbox = document.getElementById('lightbox');
      const lightboxImg = document.getElementById('lightbox-img');
      const galeriaImgs = document.querySelectorAll('.gallery-photo');

      galeriaImgs.forEach(img => {
        img.addEventListener('click', () => {
          lightbox.style.display = 'flex';
          lightboxImg.src = img.src;
        });
      });

      lightbox.addEventListener('click', () => {
        lightbox.style.display = 'none';
      });

      // 2. INICIALIZACIÓN DEL MAPA LEAFLET
      var limitesDelMundo = [[-90, -180], [90, 180]];
      var map = L.map('mapa-matech', {
        center: [20, 0],
        zoom: 2,
        minZoom: 2,
        maxBounds: limitesDelMundo,
        maxBoundsViscosity: 1.0
      });

      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        noWrap: true,
        attribution: '© OpenStreetMap contributors'
      }).addTo(map);

      // Solución para que se vean los pines azules de Leaflet
      delete L.Icon.Default.prototype._getIconUrl;
      L.Icon.Default.mergeOptions({
        iconRetinaUrl: 'https://unpkg.com/leaflet@1.9.4/dist/images/marker-icon-2x.png',
        iconUrl: 'https://unpkg.com/leaflet@1.9.4/dist/images/marker-icon.png',
        shadowUrl: 'https://unpkg.com/leaflet@1.9.4/dist/images/marker-shadow.png',
      });

      // 3. LÓGICA DE FIREBASE
      const firebaseConfig = {
        apiKey: import.meta.env.PUBLIC_FIREBASE_API_KEY,
        authDomain: import.meta.env.PUBLIC_FIREBASE_AUTH_DOMAIN,
        projectId: import.meta.env.PUBLIC_FIREBASE_PROJECT_ID,
        storageBucket: import.meta.env.PUBLIC_FIREBASE_STORAGE_BUCKET,
        messagingSenderId: import.meta.env.PUBLIC_FIREBASE_MESSAGING_SENDER_ID,
        appId: import.meta.env.PUBLIC_FIREBASE_APP_ID
      };

      const app = initializeApp(firebaseConfig);
      const db = getFirestore(app);

      async function cargarRondas() {
        try {
          const querySnapshot = await getDocs(collection(db, "rondas"));
          querySnapshot.forEach((doc) => {
            const datos = doc.data();
            if (datos.latitud !== undefined && datos.longitud !== undefined) {
              
              let fechaLegible = "Fecha desconocida";
              if (datos.fechaTimestamp) {
                const fecha = new Date(datos.fechaTimestamp);
                fechaLegible = fecha.toLocaleDateString('es-ES', {
                  day: '2-digit', month: '2-digit', year: 'numeric',
                  hour: '2-digit', minute: '2-digit'
                });
              }

              const materosTexto = (datos.materos && datos.materos.length > 0)
                ? datos.materos.join(", ")
                : "Solo";
              
              const marker = L.marker([datos.latitud, datos.longitud]).addTo(map);
              
              const popupContenido = `
                <div style="font-family: system-ui, sans-serif; padding: 4px;">
                  <h3 style="margin: 0 0 5px 0; color: #10b981;">🧉 Ronda de mates</h3>
                  <div style="border-top: 1px solid #334155; margin: 8px 0;"></div>
                  <p style="margin: 4px 0;"><strong>Fecha:</strong> ${fechaLegible}</p>
                  <p style="margin: 4px 0;"><strong>Mates:</strong> ${datos.totalMates}</p>
                  <p style="margin: 4px 0;"><strong>Materos:</strong> ${materosTexto}</p>
                </div>
              `;
              marker.bindPopup(popupContenido);
            }
          });
        } catch (error) {
          console.error("Error al cargar rondas:", error);
        }
      }

      cargarRondas();
    </script>
  </body>
</html>